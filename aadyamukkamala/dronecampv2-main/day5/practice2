    # LEGS
    # -----------------------------

    # Left leg
    pygame.draw.polygon(
        screen,
        ORANGE,
        [
            (x - 45*scale, y + 130*scale),
            (x - 5*scale, y + 130*scale),
            (x - 25*scale, y + 250*scale),
            (x - 70*scale, y + 250*scale)
        ]
    )

    # Right leg
    pygame.draw.polygon(
        screen,
        ORANGE,
        [
            (x + 5*scale, y + 130*scale),
            (x + 50*scale, y + 130*scale),
            (x + 75*scale, y + 250*scale),
            (x + 30*scale, y + 250*scale)
        ]
    )

    # Boots
    pygame.draw.rect(
        screen,
        DARK_BLUE,
        (
            x - 72*scale,
            y + 235*scale,
            45*scale,
            55*scale
        )
    )

    pygame.draw.rect(
        screen,
        DARK_BLUE,
        (
            x + 30*scale,
            y + 235*scale,
            45*scale,
            55*scale
        )
    )

    # Boot red/orange stripes
    pygame.draw.line(
        screen,
        ORANGE,
        (x - 70*scale, y + 250*scale),
        (x - 30*scale, y + 250*scale),
        max(2, int(5*scale))
    )

    pygame.draw.line(
        screen,
        ORANGE,
        (x + 32*scale, y + 250*scale),
