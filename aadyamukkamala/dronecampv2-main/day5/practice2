import pygame
import math
import random

pygame.init()

WIDTH = 1000
HEIGHT = 700
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Goku - Kamehameha!")

clock = pygame.time.Clock()

# -----------------------------
# COLORS
# -----------------------------
BLACK = (10, 10, 15)
HAIR = (15, 15, 20)
SKIN = (235, 170, 115)
ORANGE = (245, 125, 20)
DARK_ORANGE = (190, 75, 10)
BLUE = (20, 80, 190)
DARK_BLUE = (10, 35, 100)
WHITE = (255, 255, 255)
CYAN = (60, 220, 255)
LIGHT_BLUE = (150, 245, 255)
YELLOW = (255, 240, 100)

# -----------------------------
# KAMEHAMEHA PARTICLES
# -----------------------------
particles = []

for i in range(120):
    particles.append([
        random.randint(0, 350),
        random.randint(0, HEIGHT),
        random.uniform(1, 4),
        random.uniform(-1, 1)
    ])


def draw_spiky_hair(x, y, scale=1):
    """Draw black spiky anime-style hair."""

    hair_points = [
        (x - 70*scale, y + 30*scale),
        (x - 115*scale, y - 5*scale),
        (x - 65*scale, y - 10*scale),
        (x - 105*scale, y - 60*scale),
        (x - 40*scale, y - 35*scale),
        (x - 45*scale, y - 105*scale),
        (x - 5*scale, y - 55*scale),
        (x + 20*scale, y - 125*scale),
        (x + 35*scale, y - 60*scale),
        (x + 80*scale, y - 100*scale),
        (x + 65*scale, y - 45*scale),
        (x + 120*scale, y - 65*scale),
        (x + 75*scale, y - 5*scale),
        (x + 105*scale, y + 25*scale),
        (x + 55*scale, y + 25*scale),
        (x + 50*scale, y + 65*scale),
        (x - 55*scale, y + 65*scale)
    ]

    pygame.draw.polygon(screen, HAIR, hair_points)


