    )

    pygame.draw.ellipse(
        screen,
        BLACK,
        (
            x + 14*scale,
            y - 35*scale,
            18*scale,
            25*scale
        )
    )

    # Nose
    pygame.draw.line(
        screen,
        DARK_ORANGE,
        (x, y - 15*scale),
