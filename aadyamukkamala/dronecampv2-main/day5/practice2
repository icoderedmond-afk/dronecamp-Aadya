        BLUE,
        (
            x - 65*scale,
            y + 110*scale,
            130*scale,
            20*scale
        )
    )

    # Belt knot
    pygame.draw.polygon(
        screen,
        BLUE,
        [
            (x, y + 125*scale),
            (x + 45*scale, y + 150*scale),
            (x + 10*scale, y + 165*scale),
            (x - 10*scale, y + 145*scale)
        ]
    )

    # -----------------------------
    # ARMS
    # -----------------------------

    # Left arm
    pygame.draw.line(
        screen,
        ORANGE,
        (x - 65*scale, y + 45*scale),
        (x - 125*scale, y + 100*scale),
        max(5, int(28*scale))
    )

    # Right arm
    pygame.draw.line(
        screen,
        ORANGE,
        (x + 65*scale, y + 45*scale),
        (x + 125*scale, y + 100*scale),
        max(5, int(28*scale))
    )

    # Hands
    pygame.draw.circle(
        screen,
        SKIN,
        (int(x - 125*scale), int(y + 100*scale)),
        int(18*scale)
    )

    pygame.draw.circle(
        screen,
        SKIN,
        (int(x + 125*scale), int(y + 100*scale)),
        int(18*scale)
    )

    # -----------------------------
    # NECK
    # -----------------------------

    pygame.draw.rect(
        screen,
        SKIN,
        (
            x - 22*scale,
            y - 25*scale,
            44*scale,
            45*scale
        )
    )

    # -----------------------------
    # HEAD
    # -----------------------------

    pygame.draw.ellipse(
        screen,
        SKIN,
        (
            x - 52*scale,
            y - 85*scale,
            104*scale,
            100*scale
        )
    )

    # -----------------------------
    # HAIR
    # -----------------------------

    draw_spiky_hair(x, y - 60*scale, scale)

    # -----------------------------
    # FACE
    # -----------------------------

    # Eyes
    pygame.draw.ellipse(
        screen,
        BLACK,
        (
            x - 32*scale,
            y - 35*scale,
            18*scale,
            25*scale
