    )

    # Chest symbol
    pygame.draw.circle(
        screen,
        WHITE,
        (int(x + 25*scale), int(y + 60*scale)),
        int(13*scale)
    )

    font = pygame.font.SysFont("Arial", max(10, int(16*scale)), bold=True)
    symbol = font.render("悟", True, BLACK)
    screen.blit(
        symbol,
        (
            x + 17*scale,
            y + 48*scale
        )
    )


def draw_kamehameha(power):
    """
    Draws a glowing blue Kamehameha beam.
    """

    start_x = 330
    start_y = 360

    beam_length = int(300 + power * 400)

    # Glow layers
    for width, alpha in [
        (110, 30),
        (80, 50),
        (55, 80)
    ]:
        glow = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)

        pygame.draw.line(
            glow,
            (50, 180, 255, alpha),
            (start_x, start_y),
            (start_x + beam_length, start_y),
            width
        )

        screen.blit(glow, (0, 0))

    # Main beam
    pygame.draw.line(
        screen,
        CYAN,
        (start_x, start_y),
        (start_x + beam_length, start_y),
        45
    )

    pygame.draw.line(
        screen,
        WHITE,
        (start_x, start_y),
        (start_x + beam_length, start_y),
        18
    )

    # Energy ball
    radius = int(40 + power * 30)

    pygame.draw.circle(
        screen,
        CYAN,
        (start_x, start_y),
        radius
    )

    pygame.draw.circle(
        screen,
        LIGHT_BLUE,
        (start_x, start_y),
        int(radius * 0.65)
    )

    pygame.draw.circle(
        screen,
        WHITE,
        (start_x, start_y),
        int(radius * 0.3)
    )


def draw_energy_particles(power):
    for p in particles:

        p[0] += random.uniform(2, 5) * power
        p[1] += p[3]

        if p[0] > WIDTH:
            p[0] = random.randint(0, 300)
            p[1] = random.randint(0, HEIGHT)

        pygame.draw.circle(
            screen,
            CYAN,
            (int(p[0]), int(p[1])),
            random.randint(1, 4)
        )


# -----------------------------
# MAIN LOOP
# -----------------------------

running = True

power = 0
charging = True
beam = False

while running:

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_SPACE:
                charging = True
                beam = False

            if event.key == pygame.K_ESCAPE:
                running = False

        if event.type == pygame.KEYUP:

            if event.key == pygame.K_SPACE:
                beam = True
                charging = False

    # -----------------------------
    # POWER CHARGING
    # -----------------------------

    if charging:

        power += 0.008

        if power > 1:
            power = 1

    else:

        power -= 0.003

        if power < 0:
            power = 0

    # -----------------------------
    # BACKGROUND
    # -----------------------------

    screen.fill((8, 12, 30))

    # Ground
    pygame.draw.rect(
        screen,
        (20, 35, 60),
        (0, 550, WIDTH, 150)
    )

    # Energy particles
    draw_energy_particles(power)

    # -----------------------------
    # GOKU
    # -----------------------------

    draw_goku(
        210,
        300,
        1.25
    )

    # -----------------------------
    # KAMEHAMEHA
    # -----------------------------

    if charging or beam:
        draw_kamehameha(power)

    # -----------------------------
    # TEXT
    # -----------------------------

    font = pygame.font.SysFont(
        "Arial",
        32,
        bold=True
    )

    if charging:
        text = font.render(
            "HOLD SPACE: CHARGING KAMEHAMEHA!",
            True,
            LIGHT_BLUE
        )
    else:
        text = font.render(
            "KAMEHAMEHAAAAAA!!!",
            True,
            WHITE
        )

    screen.blit(
        text,
        (250, 40)
    )

    # Power meter
    pygame.draw.rect(
        screen,
        BLACK,
        (30, 620, 300, 25)
    )

    pygame.draw.rect(
        screen,
        CYAN,
        (30, 620, int(300 * power), 25)
    )

    pygame.draw.rect(
        screen,
        WHITE,
        (30, 620, 300, 25),
        3
    )

    pygame.display.flip()
    clock.tick(60)

pygame.quit()